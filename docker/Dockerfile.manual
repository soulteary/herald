# syntax=docker/dockerfile:1

# Manual/China-mirror build variant. Same hardening as docker/Dockerfile but
# uses tuna mirrors and goproxy.cn for environments without direct access.
FROM golang:1.27.0-alpine3.23 AS builder
RUN echo '' > /etc/apk/repositories && \
    echo "https://mirror.tuna.tsinghua.edu.cn/alpine/v3.23/main"      >> /etc/apk/repositories && \
    echo "https://mirror.tuna.tsinghua.edu.cn/alpine/v3.23/community" >> /etc/apk/repositories
RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app
ENV GO111MODULE=on CGO_ENABLED=0 GOPROXY=https://goproxy.cn,direct

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE
ARG USE_UPX=0
ARG TARGETOS
ARG TARGETARCH
# NOTE: version metadata lives in version-kit, not internal/config; the previous
# ldflags path (internal/config.Version) was a no-op and is corrected here.
RUN BUILD_DATE=${BUILD_DATE:-$(date +%FT%T%z)} && \
    ARCH=${TARGETARCH:-$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/;s/armv7l/arm/')} && \
    OS=${TARGETOS:-linux} && \
    GOOS=$OS GOARCH=$ARCH go build \
      -trimpath \
      -ldflags "-w -s \
        -X 'github.com/soulteary/version-kit/v2.Version=$VERSION' \
        -X 'github.com/soulteary/version-kit/v2.Commit=$COMMIT' \
        -X 'github.com/soulteary/version-kit/v2.BuildDate=$BUILD_DATE'" \
      -o /out/herald ./main.go

RUN if [ "$USE_UPX" = "1" ]; then \
      apk add --no-cache upx && \
      upx -9 -o /out/herald.min /out/herald && mv /out/herald.min /out/herald; \
    fi

FROM alpine:3.23
ENV TZ=Asia/Shanghai
RUN sed -i 's/dl-cdn.alpinelinux.org/mirror.tuna.tsinghua.edu.cn/g' /etc/apk/repositories && \
    apk add --no-cache ca-certificates tzdata && \
    cp /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    addgroup -g 10001 -S herald && \
    adduser -u 10001 -S -G herald -H -s /sbin/nologin herald && \
    rm -rf /var/cache/apk/*

COPY --from=builder /out/herald /bin/herald

USER 10001:10001
WORKDIR /app
EXPOSE 8082
ENTRYPOINT ["/bin/herald"]
